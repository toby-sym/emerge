<Window
    x:Class="Emerge.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Emerge Simulation Engine">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Window Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Padding="12,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png" Width="16" Height="16"/>
                <TextBlock Text="Emerge Simulation Engine" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Fluent Navigation View -->
        <NavigationView 
            x:Name="NavView" 
            Grid.Row="1" 
            PaneDisplayMode="LeftCompact" 
            IsBackButtonVisible="Collapsed"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="SimNavItm" Content="Simulation" Icon="Play" Tag="Simulation"/>
                <NavigationViewItem Content="Analytics" Icon="FourBars" Tag="Analytics"/>
                <NavigationViewItem Content="Genetics" Icon="Document" Tag="Genetics"/>
            </NavigationView.MenuItems>

            <!-- Frame hosting the active page -->
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>