<Page
    x:Class="Emerge.Desktop.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800" HorizontalAlignment="Left">
            <TextBlock Text="Simulation Analytics" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Real-time performance metrics and population telemetry." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Metric Cards Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Current Population" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TxtPopulationCount" Text="0" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Generation / Tick" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TxtTickCount" Text="0" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Active Seed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TxtSeedInfo" Text="0" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status / Info Box -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Performance Health" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="The simulation engine is operating at nominal tick rates. Hardware acceleration via Win2D is active." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>